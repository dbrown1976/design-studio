{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://studio.danielbrown.design/schemas/project.schema.json",
  "title": "Design Studio project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "title",
    "description",
    "status",
    "updated",
    "currentVersion",
    "versions",
    "context",
    "decisionLog"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "exploring",
        "testing",
        "resolved",
        "archived"
      ]
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "currentVersion": {
      "type": "string",
      "minLength": 1
    },
    "repositoryUrl": {
      "type": "string",
      "pattern": "^https?://"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "reviewQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "status",
          "whatChanged",
          "question",
          "decisionRationale",
          "deploymentUrl"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "Current",
              "Candidate",
              "Rejected",
              "Archived"
            ]
          },
          "whatChanged": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "decisionRationale": {
            "type": "string",
            "minLength": 1
          },
          "deploymentUrl": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "branch": {
                "type": "string",
                "minLength": 1
              },
              "commit": {
                "type": "string",
                "minLength": 1
              },
              "pullRequest": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "decisionLog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "type",
          "decision",
          "rationale"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "type": {
            "enum": [
              "accepted",
              "constraint",
              "rejected"
            ]
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem",
        "intendedOutcome",
        "users",
        "workflow",
        "currentDirection",
        "constraints",
        "acceptedDecisions",
        "openQuestions"
      ],
      "properties": {
        "problem": {
          "type": "string",
          "minLength": 1
        },
        "intendedOutcome": {
          "type": "string",
          "minLength": 1
        },
        "users": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "currentDirection": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptedDecisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "openQuestions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
