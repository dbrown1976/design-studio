{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://studio.danielbrown.design/schemas/project.schema.json",
  "title": "Design Studio project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "title",
    "description",
    "status",
    "updated",
    "currentRevision",
    "revisions",
    "explorationSets",
    "workingMode",
    "context",
    "decisionLog"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "exploring",
        "testing",
        "resolved",
        "archived"
      ]
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "currentRevision": {
      "type": "string",
      "minLength": 1
    },
    "repositoryUrl": {
      "type": "string",
      "pattern": "^https?://"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "reviewQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "previousRevisionId",
          "status",
          "summary",
          "scope",
          "preserve",
          "deploymentUrl",
          "validationStatus",
          "acceptanceChecks",
          "dateAccepted"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "previousRevisionId": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "candidate",
              "current",
              "superseded",
              "archived"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "preserve": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deploymentUrl": {
            "type": "string",
            "minLength": 1
          },
          "repositoryUrl": {
            "type": "string",
            "pattern": "^https?://"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "branch": {
                "type": "string",
                "minLength": 1
              },
              "commit": {
                "type": "string",
                "minLength": 1
              },
              "pullRequest": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "validationStatus": {
            "enum": [
              "not-reviewed",
              "in-review",
              "passed",
              "failed"
            ]
          },
          "acceptanceChecks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dateAccepted": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            ]
          }
        }
      }
    },
    "explorationSets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "baselineRevisionId",
          "question",
          "context",
          "axesOfDifference",
          "constraints",
          "evaluationCriteria",
          "alternatives",
          "testingNotes",
          "selectedAlternativeId",
          "selectionRationale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "baselineRevisionId": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string",
            "minLength": 1
          },
          "axesOfDifference": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evaluationCriteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "alternatives": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "deploymentUrl",
                "intendedDifference"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "deploymentUrl": {
                  "type": "string",
                  "minLength": 1
                },
                "intendedDifference": {
                  "type": "string",
                  "minLength": 1
                },
                "repositoryUrl": {
                  "type": "string",
                  "pattern": "^https?://"
                },
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "branch": {
                      "type": "string",
                      "minLength": 1
                    },
                    "commit": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pullRequest": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "testingNotes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "selectedAlternativeId": {
            "type": [
              "string",
              "null"
            ]
          },
          "selectionRationale": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "workingMode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "requestedAmendment",
            "mayChange",
            "mustRemainUnchanged",
            "acceptanceChecks"
          ],
          "properties": {
            "type": {
              "const": "sequential"
            },
            "requestedAmendment": {
              "type": "string",
              "minLength": 1
            },
            "mayChange": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "mustRemainUnchanged": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "acceptanceChecks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "explorationSetId"
          ],
          "properties": {
            "type": {
              "const": "exploration"
            },
            "explorationSetId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "decisionLog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "type",
          "decision",
          "rationale"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "type": {
            "enum": [
              "accepted",
              "constraint",
              "rejected"
            ]
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem",
        "intendedOutcome",
        "users",
        "workflow",
        "currentDirection",
        "constraints",
        "acceptedDecisions",
        "openQuestions"
      ],
      "properties": {
        "problem": {
          "type": "string",
          "minLength": 1
        },
        "intendedOutcome": {
          "type": "string",
          "minLength": 1
        },
        "users": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "currentDirection": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptedDecisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "openQuestions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
